# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# The dashboard/sync service loads this via python-dotenv; in production
# prefer a real secrets manager (AWS Secrets Manager, Vault, Azure Key Vault,
# etc.) and inject RALLY_API_KEY as an environment variable at deploy time.

# Rally API Key (create at: Rally UI -> your avatar -> API Keys)
RALLY_API_KEY=your_rally_api_key_here

# Optional: override values from config/config.yaml without editing the file
RALLY_WORKSPACE_ID=
RALLY_BASE_URL=

# Dash app settings
DASH_HOST=0.0.0.0
DASH_PORT=8050
DASH_DEBUG=false
